NEXT_PUBLIC_API_URL=https://api.example.com
NEXT_PUBLIC_MINIAPP_URL=https://play.example.com
NEXT_PUBLIC_REOWN_PROJECT_ID=

# Where wallets send the user after they approve a signature. Without this the
# wallet app has nowhere to return to and simply stays open, which reads as a
# failed signature. Get the direct link from BotFather: /newapp, then use
#   https://t.me/<bot_username>/<app_short_name>
# A bare https://t.me/<bot_username> also works (lands in the chat, not the app).
NEXT_PUBLIC_TELEGRAM_RETURN_URL=https://t.me/YourBot/app

# Comma-separated WalletConnect explorer ids. Restricts the wallet *chooser* to
# exactly these; leave empty to use AppKit's recommendations.
#
# This does not restrict who can connect. The QR encodes a standard
# WalletConnect pairing URI, so any WalletConnect-compatible Solana wallet can
# scan it and pair, listed here or not. What the list governs is the menu of
# tappable names — which matters most on mobile, where tapping a name deep-links
# into that specific app.
#
# Kept short on purpose: this is a Solana-only app, and most of the wallets
# AppKit would otherwise advertise are EVM-only, so choosing one is a dead end
# rather than an explanation. Add an id here when a Solana wallet is worth a
# one-tap entry of its own.
#
# Look ids up with your own project id (PowerShell):
#   $p="<NEXT_PUBLIC_REOWN_PROJECT_ID>"
#   foreach ($w in "phantom","solflare","backpack") {
#     $r = Invoke-RestMethod "https://explorer-api.walletconnect.com/v3/wallets?projectId=$p&search=$w&entries=3&page=1"
#     $r.listings.PSObject.Properties.Value | Select-Object name, id
#   }
#
# In order: Phantom, Solflare, Backpack, Trust Wallet, Exodus, Coinbase Wallet.
#
# Two notes on the last one. The explorer also lists "Base (formerly Coinbase
# Wallet)" as fd20dc426fb37566d803205b19bbc1d4096b248ac04548e3cfb6b3a38bd033aa;
# if Coinbase stops appearing in the chooser after their rebrand, swap the id
# below for that one. Coinbase has also pushed its own SDK over WalletConnect,
# so treat its presence here as worth verifying on a real device rather than
# assumed.
NEXT_PUBLIC_WALLET_IDS=a797aa35c0fadbfc1a53e7f675162ed5226968b44a19ee3d24385c64d1d3c393,1ca0bdd4747578705b1939af023d120677c64fe6ca76add81fda36e350605e79,2bd8c14e035c2d48f184aaa168559e86b0e3433228d3c4075900a221785019b0,4622a2b2d6af1c9844944291e5e7351a6aa24cd7b23099efac1b2fd875da31a0,e9ff15be73584489ca4a66f64d32c4537711797e30b6660dbcb71ea72a42b1f4,d0ca99ff52b99abc48743dad0f7fc891e041be73574f7fac4afe5d4bb83845c8
