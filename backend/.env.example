# From @BotFather. This token IS the HMAC key for initData validation.
# Leaking it means anyone can forge any user's identity. Rotate if exposed.
BOT_TOKEN=123456:ABC-DEF...

# Random string you invent. Telegram echoes it back in the
# X-Telegram-Bot-Api-Secret-Token header so you can reject spoofed webhooks.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=

# Signing key for your own access tokens. Unrelated to BOT_TOKEN. 32+ bytes.
JWT_SECRET=

# Public HTTPS origin of this API, e.g. https://api.solanagames.app
PUBLIC_API_URL=https://api.example.com

# Where the Mini App is deployed. Telegram requires HTTPS; no localhost.
MINIAPP_URL=https://play.example.com

# Comma-separated CORS allowlist. Must include MINIAPP_URL exactly.
ALLOWED_ORIGINS=https://play.example.com

DATABASE_URL=sqlite+aiosqlite:///./sga.db
# production: postgresql+asyncpg://user:pass@host:5432/sga

# Seconds an initData payload stays acceptable. Keep tight.
# 24h. Telegram hands back the original auth_date when the Mini App is
# relaunched, so a short window breaks the return trip from a wallet app.
INITDATA_MAX_AGE=86400

ENVIRONMENT=development

# Set to 1 to capture failing initData payloads for diagnose_initdata.py.
# Development only — the capture contains the user profile. Leave unset in prod.
DEBUG_AUTH=0

# Comma-separated Telegram ids allowed to manage the catalogue. Empty means
# nobody, which is the correct default — an admin API that is open until it is
# configured is open in every environment somebody forgot to configure.
#
# Find yours by messaging @userinfobot on Telegram.
ADMIN_TELEGRAM_IDS=
